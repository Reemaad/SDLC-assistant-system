' Everything after a single quote is a comment. PlantUML ignores it.
' Generate the diagram by running: plantuml container.puml

@startuml

' Load the C4 shapes for a Level 2 Container diagram.
!include <C4/C4_Container>

' Remove colours from the diagram.
skinparam monochrome true

title Assistant Portal - Container Diagram (C4 Level 2)

' Automatically arrange the diagram and display the C4 legend.
LAYOUT_WITH_LEGEND()

' People who use the Assistant Portal.
Person(pm, "Project Manager", "Views projects, reports and team capacity")

Person(technicalLead, "Technical Lead", "Manages technical work and reviews team capacity")

Person(qaLead, "QA Lead", "Reviews testing activities and QA reports")

' The Assistant Portal system and its internal containers.
System_Boundary(assistantPortal, "Assistant Portal") {

    Container(webPortal, "Web Portal", "Web Application", "Provides the user interface")

    Container(backendApi, "Backend API", "Application", "Handles requests and business logic")

    Container(reportService, "Report Service", "Service", "Generates project and QA reports")

    Container(capacityService, "Capacity Analysis Service", "Service", "Analyzes workload and team capacity")

    Container(jiraIntegration, "Jira Integration Service", "Service", "Connects the Assistant Portal to Jira")

    ContainerDb(portalDatabase, "Portal Database", "Database", "Stores portal and analysis data")
}

' External systems that we do not own or control.
System_Ext(jira, "Jira", "Manages projects, tasks and issues")

System_Ext(sso, "SSO", "Authenticates users and provides identity information")

' Relationships between users and the Web Portal.
Rel(pm, webPortal, "Views projects and reports", "HTTPS")

Rel(technicalLead, webPortal, "Views technical work and capacity", "HTTPS")

Rel(qaLead, webPortal, "Views testing reports", "HTTPS")

' Relationships between the containers.
Rel(webPortal, sso, "Authenticates users", "OIDC/HTTPS")

Rel(webPortal, backendApi, "Sends requests", "HTTPS/JSON")

Rel(backendApi, reportService, "Requests reports", "Internal API")

Rel(backendApi, capacityService, "Requests capacity analysis", "Internal API")

Rel(backendApi, jiraIntegration, "Requests Jira data", "Internal API")

Rel(backendApi, portalDatabase, "Reads and writes portal data", "SQL")

Rel(reportService, portalDatabase, "Reads reporting data", "SQL")
Rel(jiraIntegration, jira, "Reads and updates issues", "HTTPS/REST")

@enduml